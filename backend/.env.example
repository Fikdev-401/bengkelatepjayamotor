# Koneksi database MySQL
# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/atep_jaya_motor"

# Server
PORT=4000
NODE_ENV=development

# Alamat frontend yang diizinkan mengakses API (pisahkan dengan koma bila lebih dari satu)
FRONTEND_URL=http://localhost:5173

# Keamanan login admin — WAJIB diganti di production (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-kunci-rahasia-yang-panjang-dan-acak
JWT_EXPIRES_IN=7d

# Dipakai saat menjalankan `npm run seed` untuk membuat akun admin pertama
SEED_ADMIN_NAME=Admin Atep Jaya
SEED_ADMIN_EMAIL=admin@atepjayamotor.com
SEED_ADMIN_PASSWORD=admin12345
